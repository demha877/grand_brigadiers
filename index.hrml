    body { background: #0b0b0b; color: white; text-align: center; padding: 30px; font-family: Arial; }
    h1 { color: #ffd700; font-size: 2em; }
    img { width: 90%; max-width: 400px; border-radius: 15px; border: 3px solid #ffd700; margin: 20px 0; }
    .liens a { display: block; background: #ffd700; color: black; padding: 15px; margin: 10px auto; 
               width: 80%; max-width: 300px; border-radius: 10px; text-decoration: none; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Grand Brigadiers</h1>
